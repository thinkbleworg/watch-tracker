# ============================================================
# HMT Watch Tracker
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

HOST=0.0.0.0
PORT=8000
DEBUG=false

# SQLite database
DATABASE_PATH=data/hmt_tracker.db

# ------------------------------------------------------------
# Scheduler
# ------------------------------------------------------------

# Five minutes
SCHEDULER_INTERVAL_SECONDS=300

# Run the tracker once when the application starts
SCHEDULER_STARTUP_RUN=true

# ------------------------------------------------------------
# HTTP
# ------------------------------------------------------------

HTTP_TIMEOUT_SECONDS=30
HTTP_RETRIES=3

# ------------------------------------------------------------
# HMT sources
# ------------------------------------------------------------

HMT_IN_ENABLED=true
HMT_IN_BASE_URL=https://hmtwatches.in

HMT_STORE_ENABLED=true
HMT_STORE_BASE_URL=https://hmtwatches.store

# SmartPOS shop ID for hmtwatches.store
HMT_STORE_SHOP_ID=48236

# Products requested per SmartPOS API page
HMT_STORE_PAGE_SIZE=100

# ------------------------------------------------------------
# Telegram
# ------------------------------------------------------------

TELEGRAM_BOT_TOKEN="8964670457:AAGKE0Y30aljqAtcSWcJb7L4_f9tvYWjtdg"
TELEGRAM_CHAT_ID="1124775866"

#
# BOT_TOKEN = "8964670457:AAGKE0Y30aljqAtcSWcJb7L4_f9tvYWjtdg"
# CHAT_ID = "1124775866"
#

# ------------------------------------------------------------
# Alert behaviour
# ------------------------------------------------------------

# First catalogue build should not send Telegram alerts.
SEED_SILENTLY=true

# Alert only when a product is newly discovered.
ALERT_NEW_PRODUCTS_ONLY=true

# New-product alert requires the product to be in stock.
ALERT_ONLY_IN_STOCK=true

# Disabled by default according to the project requirements.
ALERT_BACK_IN_STOCK=false
ALERT_OUT_OF_STOCK=false
ALERT_PRICE_CHANGES=false