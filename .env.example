# HMT Watch Tracker production/local environment
# Keep real credentials in .env. Never commit .env.

DATABASE_PATH=data/hmt_tracker.db

# Scheduler
SCRAPE_INTERVAL_SECONDS=300
RUN_ON_STARTUP=true

# HTTP
REQUEST_TIMEOUT_SECONDS=30
REQUEST_RETRIES=3

# HMT sources
HMT_IN_ENABLED=true
HMT_IN_BASE_URL=https://hmtwatches.in
HMT_STORE_ENABLED=true
HMT_STORE_BASE_URL=https://www.hmtwatches.store
STORE_SHOP_ID=48236
STORE_PAGE_SIZE=100

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alert behaviour
SEED_CATALOGUE_SILENTLY=true
ALERT_NEW_PRODUCTS_ONLY=true
ALERT_ONLY_WHEN_IN_STOCK=true

# Notify when an existing tracked watch returns to stock.
ALERT_BACK_IN_STOCK=true

# Optional: notify again while the same tracked watch remains in stock.
ALERT_REPEAT_ENABLED=false
ALERT_REPEAT_INTERVAL_MINUTES=10

ALERT_OUT_OF_STOCK=false
ALERT_PRICE_CHANGES=false
