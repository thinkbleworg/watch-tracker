[Unit]
Description=HMT Watch Tracker (single run)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/watch-tracker
EnvironmentFile=/home/ubuntu/watch-tracker/.env
ExecStart=/home/ubuntu/watch-tracker/venv/bin/python /home/ubuntu/watch-tracker/main.py
StandardOutput=journal
StandardError=journal
