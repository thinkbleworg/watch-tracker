+    process_existing_watch(db, tracker, coming)
+    process_existing_watch(db, tracker, coming)
+    process_existing_watch(db, tracker, make_watch())
+    assert [x['alert_type'] for x in reversed(db.get_alerts())] == ['coming_soon', 'back_in_stock']
+
+
